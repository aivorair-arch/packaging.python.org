## 🧠 AI Model Router (هسته اصلی سیستم)

### 1. معماری ماژولار
```typescript
// packages/ai-router/index.ts
import { TextModel } from './providers/text';
import { VisionModel } from './providers/vision';
import { CodeModel } from './providers/coding';

export class AIVORARouter {
  private models = {
    text: new TextModel(),
    vision: new VisionModel(),
    coding: new CodeModel(),
    image: new ImageGenerator(),
    research: new ResearchOrchestrator()
  };

  route(task: AITask): AIProvider {
    switch(task.intent) {
      case 'chat':
      case 'summarize':
      case 'translate':
        return this.models.text;
      
      case 'analyze_image':
      case 'ocr':
        return this.models.vision;
      
      case 'generate_code':
      case 'debug':
        return this.models.coding;
      
      case 'web_search':
      case 'research':
        return this.models.research;
      
      case 'generate_image':
        return this.models.image;
      
      default:
        // Fallback to most capable text model
        return this.models.text;
    }
  }
}
```

