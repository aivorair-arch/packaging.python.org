## 🌐 رابط کاربری (UI/UX Implementation)

### 1. سیستم چت پیشرفته (Streaming)
```tsx
// apps/web/components/ChatInterface.tsx
'use client';

import { useState, useRef, useEffect } from 'react';
import { useChat } from 'ai/react';

export default function ChatInterface() {
  const [attachments, setAttachments] = useState<File[]>([]);
  const { messages, input, handleInputChange, handleSubmit, isLoading, stop } = useChat({
    api: '/api/chat',
    onFinish: (message) => {
      // Analytics tracking
      trackEvent('chat:response', {
        messageId: message.id,
        tokens: message.metadata?.tokens
      });
    }
  });

  const handleSubmitWithAttachments = async (e: React.FormEvent) => {
    e.preventDefault();
    
    const formData = new FormData();
    formData.append('input', input);
    
    attachments.forEach(file => {
      formData.append('files', file);
    });

    await handleSubmit(e, {
      data: formData
    });
    
    setAttachments([]);
  };

  return (
    <div className="flex flex-col h-screen bg-background">
      {/* Conversation History */}
      <div className="flex-1 overflow-y-auto p-4 space-y-4">
        {messages.map((message) => (
          <MessageBubble 
            key={message.id} 
            role={message.role}
            content={message.content}
            isLoading={isLoading && message.id === messages[messages.length - 1]?.id}
          />
        ))}
      </div>

      {/* Attachment Preview */}
      {attachments.length > 0 && (
        <div className="p-2 bg-muted border-t border-border flex gap-2 overflow-x-auto">
          {attachments.map((file, index) => (
            <AttachmentPreview 
              key={index} 
              file={file} 
              onRemove={() => {
                const newFiles = [...attachments];
                newFiles.splice(index, 1);
                setAttachments(newFiles);
              }} 
            />
          ))}
        </div>
      )}

      {/* Input Area */}
      <ChatInput
        input={input}
        handleInputChange={handleInputChange}
        handleSubmit={handleSubmitWithAttachments}
        isLoading={isLoading}
        onStop={stop}
        onFileSelect={(files) => setAttachments([...attachments, ...files])}
      />
    </div>
  );
}
```

